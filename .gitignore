# Secrets
credentials.json
token.pickle
token.json
client_secret_*.json
*token_cache*.json
*.pem

# Deployment/runtime environment secrets. Public templates remain tracked.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Local protected-sender list (PII: real lawyer/banks/gov/self) — never commit.
# Use config/protected_senders.example.txt as the template.
config/protected_senders.local.txt

# Logs
*.log
gmail_labeler.log

# Test, coverage, and package-build output
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Triage audit artifacts (PII: addresses, subjects, account ids) — never commit.
# audit/README.md and audit/.gitignore are source; every generated artifact is not.
audit/*
!audit/.gitignore
!audit/README.md

# Durable app store (Stripe customer ids, api keys, receipt ledger) — never commit.
data/
*.db
*.db-wal
*.db-shm

# Local runtime cursors and exports. These are generated from mailbox state and
# must never become source artifacts, even when a particular snapshot is empty.
*_state.json
.state.*.tmp
mail_export.tsv
mail_report.md

# Python
__pycache__/
*.py[cod]
build/
dist/
.venv/
env/
venv/
.DS_Store

# Node/frontend dependency and build output
node_modules/
web/.next/
web/out/

# Local Claude Code settings (personal permission rules) — never commit.
.claude/settings.local.json

# Local agent/session state — contains transcripts, prompts, and private context.
.claude/sessions/
.claude/worktrees/
.codex/sessions/
.worktrees/
.serena/

# Merge/rebase scratch files are not product source.
*.main
pr[0-9]*.txt
